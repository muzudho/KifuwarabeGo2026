    </MonoGameContentReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KifuwarabeGo2026.InstallerEngine\KifuwarabeGo2026.InstallerEngine.csproj" />
    <ProjectReference Include="..\KifuwarabeGo2026.InstallerEngine.JsonLines\KifuwarabeGo2026.InstallerEngine.JsonLines.csproj" />
    <ProjectReference Include="..\KifuwarabeGo2026.InstallerEngine.Platform\KifuwarabeGo2026.InstallerEngine.Platform.csproj" />
    <ProjectReference Include="..\KifuwarabeGo2026.InstallerGui.Platform\KifuwarabeGo2026.InstallerGui.Platform.csproj" />
    <ProjectReference Include="..\KifuwarabeGo2026.InstallerGui.Presentation\KifuwarabeGo2026.InstallerGui.Presentation.csproj" />
    <ProjectReference Include="..\KifuwarabeGo2026.StationeryUI\KifuwarabeGo2026.StationeryUI.csproj" />
  </ItemGroup>
</Project>
