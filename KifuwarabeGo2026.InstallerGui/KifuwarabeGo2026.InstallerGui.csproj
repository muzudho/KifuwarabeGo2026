    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KifuwarabeGo2026.Installer</AssemblyName>
    <RootNamespace>KifuwarabeGo2026.InstallerGui</RootNamespace>
    <RollForward>Major</RollForward>
