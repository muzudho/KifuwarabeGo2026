    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KifuwarabeGo2026.Launcher</AssemblyName>
    <RootNamespace>KifuwarabeGo2026.Launcher</RootNamespace>
