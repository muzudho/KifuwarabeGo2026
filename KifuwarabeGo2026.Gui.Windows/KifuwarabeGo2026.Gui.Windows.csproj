<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>KifuwarabeGo2026.Gui</AssemblyName>
    <RootNamespace>KifuwarabeGo2026.Gui</RootNamespace>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <Version>2.6.0</Version>
    <AssemblyVersion>2.6.0.0</AssemblyVersion>
    <FileVersion>2.6.0.0</FileVersion>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>..\KifuwarabeGo2026.Gui\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\KifuwarabeGo2026.Gui\GuiIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\KifuwarabeGo2026.Gui\Icon.ico">
      <Link>Icon.ico</Link>
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\KifuwarabeGo2026.Gui\GuiIcon.ico">
      <Link>GuiIcon.ico</Link>
      <LogicalName>GuiIcon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\KifuwarabeGo2026.Gui\Icon.bmp">
      <Link>Icon.bmp</Link>
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="..\KifuwarabeGo2026.Gui\Content\Content.mgcb">
      <Link>Content\Content.mgcb</Link>
    </MonoGameContentReference>
    <None Include="..\KifuwarabeGo2026.Gui\Content\GtpEngines\gtp-engine-list.example.json">
      <Link>Content\GtpEngines\gtp-engine-list.example.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KifuwarabeGo2026.Gui\KifuwarabeGo2026.Gui.Core.csproj" />
  </ItemGroup>
  <Target Name="PublishCgosCommunication" AfterTargets="Publish">
    <PropertyGroup>
      <CgosCommunicationProject>$(MSBuildProjectDirectory)\..\KifuwarabeGo2026.Gui.Communication.Cgos\KifuwarabeGo2026.Gui.Communication.Cgos.csproj</CgosCommunicationProject>
      <CgosCommunicationPublishDir>$(PublishDir)Tools\Cgos\</CgosCommunicationPublishDir>
    </PropertyGroup>
    <Message Text="Publishing CGOS communication component to $(CgosCommunicationPublishDir)" Importance="High" />
    <Exec Condition="'$(RuntimeIdentifier)' == ''" Command="dotnet publish &quot;$(CgosCommunicationProject)&quot; --configuration $(Configuration) --framework net8.0 --self-contained $(SelfContained) -p:DebugType=$(DebugType) -p:DebugSymbols=$(DebugSymbols) --output &quot;$(CgosCommunicationPublishDir)&quot;" />
    <Exec Condition="'$(RuntimeIdentifier)' != ''" Command="dotnet publish &quot;$(CgosCommunicationProject)&quot; --configuration $(Configuration) --framework net8.0 --runtime $(RuntimeIdentifier) --self-contained $(SelfContained) -p:DebugType=$(DebugType) -p:DebugSymbols=$(DebugSymbols) --output &quot;$(CgosCommunicationPublishDir)&quot;" />
  </Target>
</Project>
